block Skill {
    component Pill {
        padding: 6 14
        radius: 9999
        color: #121B2E
        border: 1 #23324D

        component Label {
            text: "Skill"
            fontSize: 13
            fontWeight: medium
            color: #AEC2F2
        }
    }
}

block Status {
    component Pill {
        layout: horizontal
        gap: 6
        alignItems: center
        padding: 5 12
        radius: 9999
        color: #0F2A1E
        border: 1 #1E4A34

        component Dot {
            width: 6
            height: 6
            radius: 3
            color: #34D399
        }

        component Label {
            text: "Status"
            fontSize: 12
            fontWeight: medium
            color: #6EE7B7
        }
    }
}

block Tag {
    component Pill {
        padding: 4 10
        radius: 9999
        color: #0D1626
        border: 1 #1E293F

        component Label {
            text: "Tag"
            fontSize: 11
            fontWeight: bold
            color: #8A94A6
        }
    }
}
